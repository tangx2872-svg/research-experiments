{
  "experiment": "Experiment 1E Cross-Category Validation",
  "category": "grid",
  "seed": 2,
  "alphas": [
    0.0,
    0.25,
    0.5,
    0.75,
    1.0
  ],
  "defect_types": [
    "bent",
    "broken",
    "glue",
    "metal_contamination",
    "thread"
  ],
  "backbone": "wide_resnet50_2",
  "layers": [
    "layer2",
    "layer3"
  ],
  "coreset_sampling_ratio": 0.1,
  "num_neighbors": 9,
  "image_size": 256,
  "val_size": 20,
  "train_size": 244,
  "n_test_good": 21,
  "log_area_epsilon": 1e-09,
  "z_normalization": "test/good contemporaneous (same seed+alpha), ddof=1",
  "d_prime": "pooled_std sqrt((sd^2+sg^2)/2)"
}